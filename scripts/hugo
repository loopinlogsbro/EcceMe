#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
IFS= read -r version < hugo.lock
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Invalid Hugo version in hugo.lock" >&2
  exit 1
fi

case "$(uname -s):$(uname -m)" in
  Linux:x86_64) target=linux-amd64 ;;
  Linux:aarch64) target=linux-arm64 ;;
  *)
    echo "This checkout supports pinned Hugo builds on Linux amd64 and arm64" >&2
    exit 1
    ;;
esac

archive="hugo_${version}_${target}.tar.gz"
digest=$(awk -v archive="$archive" '$2 == archive { print $1 }' hugo.lock)
if [[ ! $digest =~ ^[0-9a-f]{64}$ ]]; then
  echo "Missing or invalid Hugo checksum for $archive" >&2
  exit 1
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}/ecce-hugo/$digest"
mkdir -p "$cache"
stage=$(mktemp -d "$cache/install.XXXXXXXX")
cleanup() {
  for file in "$stage/$archive" "$stage/hugo"; do
    [[ ! -e $file ]] || unlink "$file"
  done
  rmdir "$stage"
}
trap cleanup EXIT

checksum() {
  printf '%s  %s\n' "$digest" "$1" | sha256sum --check --status
}

cached="$cache/$archive"
if ! checksum "$cached" 2>/dev/null; then
  curl --fail --silent --show-error --location --retry 2 --connect-timeout 15 --max-time 90 \
    --output "$stage/$archive" \
    "https://github.com/gohugoio/hugo/releases/download/v$version/$archive"
  if ! checksum "$stage/$archive"; then
    echo "Hugo archive checksum mismatch" >&2
    exit 1
  fi
  mv -- "$stage/$archive" "$cached"
fi

tar -xzf "$cached" -C "$stage" hugo
"$stage/hugo" "$@"
